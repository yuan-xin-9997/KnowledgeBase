# 服务监听
HOST=0.0.0.0
PORT=36080
NODE_ENV=production

# 数据目录：SQLite、secret.key
DATA_DIR=./data

# 加密主密钥（来源密码 / 模型 API Key）。留空会自动生成到 DATA_DIR/secret.key
# APP_SECRET=请替换为至少 32 位随机字符串

# 反向代理的外部 Origin（可选）
# APP_ORIGIN=https://kb.example.com

# 是否开放注册
ALLOW_REGISTRATION=true
SESSION_DAYS=30
SYNC_SCHEDULER=true
# /api/v1 与 /mcp 每 IP 每分钟请求上限
API_RATE_LIMIT=120
TZ=Asia/Shanghai
